server {
    server_name pops.lojanovamix.com.br;

    # Cadastro de POP envia várias imagens no mesmo multipart/form-data
    # (até 5MB cada, validado na aplicação) - o padrão do nginx (1MB) bloquearia isso antes.
    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:3008;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/pops.lojanovamix.com.br/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/pops.lojanovamix.com.br/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = pops.lojanovamix.com.br) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name pops.lojanovamix.com.br;
    return 404; # managed by Certbot


}
